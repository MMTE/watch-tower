# --- Core ---
# API_PORT is the local listen port. On Railway / Heroku / Fly the platform
# injects PORT, which takes precedence over API_PORT.
API_PORT=3000
API_KEY=watchtower_secret_key_change_me

# Optional: comma-separated default fan-out list. If unset, all enabled
# channels are used unless the API/MCP request specifies "channels".
# Example: DEFAULT_CHANNELS=telegram,ntfy
DEFAULT_CHANNELS=

# --- Telegram channel ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# If set, Telegram uses webhook mode; otherwise polling.
# Use the public HTTPS URL of this service (no trailing slash, no path).
# Example on Railway: WEBHOOK_URL=https://watch-tower-production.up.railway.app
WEBHOOK_URL=

# --- Bale channel (Telegram-compatible BotAPI) ---
BALE_BOT_TOKEN=
BALE_CHAT_ID=

# --- Pushover channel ---
# https://pushover.net
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_DEVICE=

# --- Gotify channel ---
# https://gotify.net
GOTIFY_URL=
GOTIFY_APP_TOKEN=

# --- ntfy channel ---
# Public: https://ntfy.sh ; or self-hosted URL
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Optional auth:
NTFY_TOKEN=
NTFY_USER=
NTFY_PASSWORD=

# --- Telegram via proxy (optional) ---
# Set when api.telegram.org is unreachable from this network (e.g. filtered egress).
# Scoped to Telegram traffic only; other channels connect directly.
# Example: TELEGRAM_PROXY=http://10.120.0.10:3128
TELEGRAM_PROXY=
